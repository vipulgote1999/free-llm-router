{
  "name": "free-llm-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible router for free LLM providers on Cloudflare Workers with rate-limit tracking and automatic failover",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/benchmark.mjs",
    "bench:accuracy": "vitest run test/routing-accuracy.test.ts"
  },
  "devDependencies": {
    "openai": "^7.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-linux-arm64": "^1.20260811.1",
    "wrangler": "^4.100.0"
  }
}
